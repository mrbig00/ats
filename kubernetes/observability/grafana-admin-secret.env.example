# Copy to grafana-admin-secret.env, set a strong password, never commit the real file.
# Create the secret in the observability namespace before the first helmfile deploy:
#
#   kubectl create namespace observability --dry-run=client -o yaml | kubectl apply -f -
#   kubectl create secret generic grafana-admin -n observability \
#     --from-env-file=kubernetes/observability/grafana-admin-secret.env
#
# Expected keys (used by the Grafana Helm chart existingSecret):
admin-user=admin
admin-password=change-me
